# Copiar a .env y completar. Nunca versionar .env.

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# 1 solo en desarrollo local. En el servidor: 0
DJANGO_DEBUG=0
# Hosts separados por coma (p. ej. datos.universidad.example)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes para CSRF detrás de HTTPS (p. ej. https://datos.universidad.example)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Modo de base de datos: "demo" (base local ficticia) o "real" (base universitaria).
APP_DB_MODE=demo

# --- Base de DEMOSTRACIÓN (local, datos ficticios) ---
# El nombre debe contener "demo" y el host ser local; si no, la carga de datos ficticios se niega a ejecutarse.
DEMO_DB_NAME=leire_demo
DEMO_DB_USER=leire_demo
DEMO_DB_PASSWORD=
DEMO_DB_HOST=localhost
DEMO_DB_PORT=5433

# --- Base REAL (universidad) - solo se usa con APP_DB_MODE=real ---
# Pendiente de validar con la universidad. No ejecutar migraciones sin aprobación.
REAL_DB_NAME=
REAL_DB_USER=
REAL_DB_PASSWORD=
REAL_DB_HOST=
REAL_DB_PORT=5432
# disable | allow | prefer | require | verify-ca | verify-full
REAL_DB_SSLMODE=prefer
# Opcional: search_path, p. ej. "app_web,public" para separar tablas de la aplicación
REAL_DB_SEARCH_PATH=

# Solo para una migración aprobada contra la base real. Dejar vacío.
ALLOW_REAL_DB_MIGRATIONS=
